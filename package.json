{
  "name": "pagepaint",
  "version": "0.4.0",
  "description": "Local-first page feedback: draw, capture, record, and save to your repository.",
  "homepage": "https://pagepaint.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/pagepaint/pagepaint.git"
  },
  "bugs": {
    "url": "https://github.com/pagepaint/pagepaint/issues"
  },
  "type": "module",
  "main": "dist/pagepaint.js",
  "module": "dist/pagepaint.mjs",
  "exports": {
    ".": {
      "import": "./dist/pagepaint.mjs",
      "default": "./dist/pagepaint.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node scripts/build.js && npm run build:extension",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "build:cdn": "npm run build && node scripts/build-cdn.js",
    "deploy": "npm run build:cdn && cf deploy --prebuilt",
    "build:extension": "node scripts/build-extension.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "html2canvas-pro": "2.5.1",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "prettier": "3.8.5"
  },
  "license": "MIT",
  "private": true
}
