{
  "name": "@devplant/review-tool",
  "version": "0.1.0",
  "description": "A drop-in feedback widget with annotated viewport captures and a local backend.",
  "type": "module",
  "main": "dist/review-tool.js",
  "module": "dist/review-tool.mjs",
  "exports": {
    ".": {
      "import": "./dist/review-tool.mjs",
      "default": "./dist/review-tool.js"
    }
  },
  "files": [
    "dist",
    "server",
    "src/archive.js",
    "src/context.js",
    "index.html",
    "demo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node server/index.js",
    "dev": "npm run build && npm start",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "html2canvas-pro": "2.5.1",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "prettier": "3.8.5"
  },
  "license": "MIT"
}
